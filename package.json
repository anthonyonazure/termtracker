{
  "name": "termtracker",
  "version": "1.0.0",
  "description": "Claude Code usage dashboard for system tray",
  "main": "dist-electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "mutation": "stryker run",
    "check": "bun run typecheck && bun run lint",
    "dev": "vite",
    "start": "vite build && start.cmd",
    "build": "tsc && vite build && electron-builder --config electron-builder.json",
    "build:vite": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --config electron-builder.json"
  },
  "dependencies": {
    "menubar": "^9.5.3",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "postcss": "^8.5.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^8.0.0"
  },
  "overrides": {
    "@babel/core": ">=8.0.1",
    "@tootallnate/once": ">=3.0.1",
    "@xmldom/xmldom": ">=0.9.10",
    "app-builder-lib": ">=26.15.3",
    "axios": ">=1.19.0",
    "brace-expansion": ">=5.0.9",
    "builder-util-runtime": ">=9.7.0",
    "fast-uri": ">=4.1.2",
    "follow-redirects": ">=1.16.0",
    "form-data": ">=4.0.6",
    "hosted-git-info": ">=7.0.2",
    "ip-address": ">=10.4.0",
    "joi": ">=18.2.3",
    "js-yaml": ">=5.2.3",
    "lodash": ">=4.18.1",
    "picomatch": ">=4.0.5",
    "qs": ">=6.15.3",
    "shell-quote": ">=1.10.0",
    "tar": ">=7.5.22",
    "tmp": ">=0.2.7",
    "nanoid": ">=3.3.18 <4"
  }
}
